{
  "name": "sebastian-maschberger",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/setup.mjs --test tests/*.test.ts",
    "db:setup": "node --conditions=react-server --env-file=.env.local --import=tsx scripts/setup-db.ts",
    "setup": "node scripts/configure-auth.mjs",
    "create:site": "node scripts/create-site.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "verify:local": "node scripts/verify-local.mjs",
    "preflight": "node --conditions=react-server --import=tsx scripts/preflight.mjs",
    "social:assets": "node scripts/prepare-social-assets.mjs",
    "upgrade:site": "node scripts/upgrade-site.mjs",
    "backup:create": "node --conditions=react-server --env-file-if-exists=.env.local --import=tsx scripts/backup-site.ts create",
    "backup:restore": "node --conditions=react-server --import=tsx scripts/backup-site.ts restore",
    "recovery:preview": "node scripts/recovery-preview.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.94",
    "@ai-sdk/openai": "4.0.106",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/rubik": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@neondatabase/serverless": "1.2.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@vercel/blob": "2.8.2",
    "@vercel/queue": "0.10.0",
    "ai": "7.0.159",
    "fflate": "0.8.3",
    "lucide-react": "^0.577.0",
    "mediabunny": "1.64.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "0.183.2",
    "web-push": "4.0.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    },
    "@vercel/queue": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.183.1",
    "@types/web-push": "3.6.4",
    "axe-core": "^4.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "description": "Eigenständige Websites mit visuellem CMS, Projektgenerator und Codex-Skill."
}
