# Jede Website erhält eine eigene Datenbank, einen eigenen Blob-Store und eigene Schlüssel.
DATABASE_URL=
# Entwicklung/Tests bleiben lokal, auch wenn eine DATABASE_URL vorhanden ist.
WS_USE_REMOTE_DATABASE=0
WS_DB_METRICS=0
BLOB_READ_WRITE_TOKEN=
AUTH_SECRET=
ADMIN_INITIAL_PASSWORD_HASH=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DESIGN_REVIEW=true
NEXT_PUBLIC_SITE_VARIANT=1

# Optional commerce: no real checkout unless explicitly enabled after merchant setup and sandbox verification.
COMMERCE_CHECKOUT_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYPAL_ENABLED=0
COMMERCE_SHIPPING_COUNTRIES=DE
# Separate PRIVATE Blob store. Never use the public media token here.
PRIVATE_COMMERCE_BLOB_READ_WRITE_TOKEN=

# Optional Social-Studio: this website's own PRIVATE Blob store for uploaded assets.
# Never reuse the public media token or another website's store. Local files stay in .data/social-assets.
PRIVATE_SOCIAL_BLOB_READ_WRITE_TOKEN=

# Optional CMS assistant: enabled separately in the saved website draft.
# Set an explicit provider (openai or anthropic), a model supported by that account,
# and that website's own provider key. Empty values never connect to an AI service.
CMS_AI_PROVIDER=
CMS_AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Post-Planner. Enable only after the own Instagram account, signed HTTPS media route,
# native Queue trigger and recovery cron have been configured and verified. Draft planning works without this.
SOCIAL_PUBLISHING_QUEUE_ENABLED=0
